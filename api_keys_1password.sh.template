# Preferred secrets path (1Password CLI).
# Copy this file to api_keys_1password.sh (gitignored) and customize item refs.
# Prefer this over api_keys.sh — keep long-lived keys out of plain files.
#
# Prerequisites:
#   1. Install 1Password CLI: brew install --cask 1password-cli  (core Brewfile)
#   2. 1Password desktop app: Settings → Developer → "Integrate with 1Password CLI"
#   3. Unlock the app / sign in so `op whoami` succeeds
#   4. Create vault items for each service (field names match your refs below)
#
# Reference format for op_secret:
#   "Vault/Item/field"  →  op://Vault/Item/field
# Examples of field labels: credential, password, api_key, token, username
#
# One-shot alternative (no export into the parent shell):
#   op run --env-file=./.env.tpl -- some-command
#   (use op:// refs inside the env file; see `op run --help`)
#
# To add a secret:
#   1. Store it in 1Password
#   2. Uncomment/add: export VAR_NAME="$(op_secret "Vault/Item/field")"
#
# Suggested vault layout (active vault: "Dot Secrets"):
#   Vault: Dot Secrets
#   Item:  service name (e.g. "OpenAI API Key", "Anthropic API Key")
#   Field: credential / api_key / token

# Fetch a secret via 1Password CLI.
# Args: Vault/Item/field (without the op:// prefix)
# Prints the secret on stdout, or empty if op is missing / not signed in / read fails.
# Never prints the secret on stderr. With DOTFILES_DEBUG=1, warns once if op is unavailable.
op_secret() {
    local path="${1:-}"
    if [[ -z "$path" ]]; then
        return 0
    fi

    if ! command -v op &>/dev/null; then
        if [[ -n "${DOTFILES_DEBUG:-}" && -z "${_DOTFILES_OP_WARNED:-}" ]]; then
            echo "dotfiles: op (1Password CLI) not found; secrets from api_keys_1password.sh will be empty" >&2
            typeset -g _DOTFILES_OP_WARNED=1 2>/dev/null || _DOTFILES_OP_WARNED=1
        fi
        return 0
    fi

    if ! op whoami &>/dev/null; then
        if [[ -n "${DOTFILES_DEBUG:-}" && -z "${_DOTFILES_OP_WARNED:-}" ]]; then
            echo "dotfiles: op is not signed in (unlock 1Password / run op signin); secrets will be empty" >&2
            typeset -g _DOTFILES_OP_WARNED=1 2>/dev/null || _DOTFILES_OP_WARNED=1
        fi
        return 0
    fi

    op read "op://${path}" 2>/dev/null || true
}

# --- Exports (tracked template; no secret values, only op:// refs) ---
# Copy to api_keys_1password.sh (gitignored) on a new host if you need local overrides.
# Active line below is a working example for vault "Dot Secrets".

export OPENAI_API_KEY="$(op_secret "Dot Secrets/OpenAI API Key/credential")"
export ANTHROPIC_API_KEY="$(op_secret "Dot Secrets/Anthropic API Key/credential")"
export GITHUB_TOKEN="$(op_secret "Dot Secrets/GitHub/token")"
export LANGCHAIN_API_KEY="$(op_secret "Dot Secrets/LangChain/credential")"
export TAVILY_API_KEY="$(op_secret "Dot Secrets/Tavily API Key/credential")"

