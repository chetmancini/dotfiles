# Preferred secrets path (1Password CLI) — prompt-free shell startup.
# Copy this file to api_keys_1password.sh (gitignored) and customize item refs.
# Prefer this over api_keys.sh — keep long-lived keys out of plain files.
#
# Prerequisites:
#   1. Install 1Password CLI: brew install --cask 1password-cli  (core Brewfile)
#   2. 1Password desktop app: Settings → Developer → "Integrate with 1Password CLI"
#   3. Run `refresh-secrets` once to unlock 1Password and populate the cache.
#
# How it works:
#   - Shell startup NEVER calls `op`, so new shells never block on a
#     1Password prompt and start fast — even when the vault is locked.
#   - Startup only sources the cache below (mode 0600). No cache yet (or key
#     rotated)? Run `refresh-secrets`: it unlocks 1Password (the one prompt),
#     fetches every ref, exports them into the current shell, and rewrites
#     the cache for all future shells.
#
# Reference format for op_secret:
#   "Vault/Item/field"  →  op://Vault/Item/field
# Examples of field labels: credential, password, api_key, token, username
#
# One-shot alternative (no export into the parent shell):
#   op run --env-file=./.env.tpl -- some-command
#   (use op:// refs inside the env file; see `op run --help`)
#
# To add a secret:
#   1. Store it in 1Password
#   2. Add an entry to _dotfiles_op_entries below:
#        VAR_NAME|Vault/Item/field
#
# Suggested vault layout (active vault: "Dot Secrets"):
#   Vault: Dot Secrets
#   Item:  service name (e.g. "OpenAI API Key", "Anthropic API Key")
#   Field: credential / api_key / token

# Local cache of fetched secrets. Sourced at startup instead of calling `op`.
# Tunables: XDG_CACHE_HOME (location), DOTFILES_OP_CACHE_DAYS (age-hint threshold).
_DOTFILES_OP_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/op-secrets.zsh"
: "${DOTFILES_OP_CACHE_DAYS:=30}"

# VAR_NAME|Vault/Item/field — single source of truth for fetch + cache.
_dotfiles_op_entries=(
    'OPENAI_API_KEY|Dot Secrets/OpenAI API Key/credential'
    'ANTHROPIC_API_KEY|Dot Secrets/Anthropic API Key/credential'
    'GITHUB_TOKEN|Dot Secrets/GitHub/token'
    'LANGCHAIN_API_KEY|Dot Secrets/LangChain/credential'
    'TAVILY_API_KEY|Dot Secrets/Tavily API Key/credential'
)

# Fetch a secret via 1Password CLI.
# Args: Vault/Item/field (without the op:// prefix)
# Prints the secret on stdout, or empty if op is missing / locked / read fails.
# Never prompts, never prints the secret on stderr.
op_secret() {
    # NOTE: never name this `path` — lowercase `path` is tied to $PATH in zsh,
    # so `local path=...` would clobber the command search path in this scope
    # and every `op` call below would fail.
    local item_ref="${1:-}"
    [[ -z "$item_ref" ]] && return 0
    command -v op &>/dev/null || return 0
    op read "op://${item_ref}" 2>/dev/null || true
}

# Unlock 1Password if needed (the ONE place a prompt is acceptable — explicit),
# then fetch every entry, export into this shell, and rewrite the cache.
# Re-run after rotating keys. Empty reads never clobber existing values.
refresh-secrets() {
    if ! command -v op &>/dev/null; then
        echo "dotfiles: op (1Password CLI) not found; install it (brew install --cask 1password-cli)" >&2
        return 1
    fi
    if ! op whoami &>/dev/null; then
        echo "dotfiles: unlocking 1Password (one-time; future shells won't prompt)..." >&2
        op signin || return 1
    fi

    local cache="${_DOTFILES_OP_CACHE:?}" tmp
    mkdir -p "${cache:h}" || return 1
    tmp="$(mktemp "${cache:h}/.op-secrets.XXXXXX")" || return 1

    local entry var ref val ok=0 total=0
    {
        echo "# Generated by refresh-secrets on $(date '+%Y-%m-%d %H:%M:%S'). Mode 0600. Do not commit."
        for entry in "${_dotfiles_op_entries[@]}"; do
            var="${entry%%|*}"
            ref="${entry#*|}"
            total=$((total + 1))
            val="$(op_secret "$ref")"
            if [[ -n "$val" ]]; then
                echo "export ${var}=${(q)val}"
                ok=$((ok + 1))
            else
                echo "dotfiles: refresh-secrets: empty read for ${var} (ref: ${ref})" >&2
            fi
        done
    } >"$tmp"
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$cache" || { rm -f "$tmp"; return 1; }
    source "$cache" || return 1
    echo "dotfiles: secrets refreshed (${ok}/${total} fetched, cached in ${cache})." >&2
    return 0
}

# --- Startup: cache only. Never call `op` here, so shells stay prompt-free. ---
if [[ -r "$_DOTFILES_OP_CACHE" ]]; then
    source "$_DOTFILES_OP_CACHE" || true
    if [[ -o interactive && "${DOTFILES_OP_CACHE_DAYS:-30}" -gt 0 ]] \
        && [[ -n "$(find "$_DOTFILES_OP_CACHE" -mtime +"$DOTFILES_OP_CACHE_DAYS" -print 2>/dev/null)" ]]; then
        echo "dotfiles: secrets cache older than ${DOTFILES_OP_CACHE_DAYS}d — run 'refresh-secrets' after rotating keys." >&2
    fi
else
    [[ -o interactive ]] && echo "dotfiles: secrets cache missing — run 'refresh-secrets' to unlock 1Password and load API keys." >&2
fi
