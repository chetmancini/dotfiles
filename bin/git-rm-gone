#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# git-rm-gone: Delete local branches whose upstream tracking branch is gone,
# and remove the worktrees checked out on those branches.
#
# Preview-first: listing (with merged/unmerged classification) is the default;
# nothing is deleted or removed unless --apply is supplied. Branch deletion
# uses safe `git branch -d` so unmerged work is preserved unless --force is
# given. Worktrees are only removed when clean; worktrees with uncommitted
# changes, locked, bare, detached, or current worktrees are always preserved.

APPLY=false
ASSUME_YES=false
FORCE=false
DRY_RUN=false

# `git worktree list --porcelain` records (index 0 is the main worktree).
WT_PATHS=()
WT_BRANCHES=()
WT_KINDS=()
WT_LOCKED=()
# Classification results for linked worktrees.
WT_REMOVABLE=()
WT_REMOVABLE_BRANCHES=()
STALE_PATHS=()
WT_REPORT=()
CURRENT_TOPLEVEL=""
GONE=()

print_help() {
    cat <<'EOF'
Usage: git-rm-gone [options]

List local branches whose upstream tracking branch is gone (after
`git fetch --prune`) and the worktrees checked out on those branches,
and optionally clean them up. Preview is the default; nothing is
deleted or removed unless --apply is supplied.

Options:
  --apply          Delete gone branches (merged ones, with `git branch -d`)
                   and remove their clean, merged worktrees
  --yes, -y        Skip the interactive confirmation (requires --apply)
  --force, -f      Also delete unmerged gone branches with `git branch -D`
                   and remove their worktrees
                   (requires --apply; unmerged work is preserved without it)
  --dry-run, -n    Show what would be done without changing anything
                   (the default)
  -h, --help       Show this help

Safety:
  The current branch and the worktree you run from are always skipped.
  Worktrees with uncommitted or ignored files, locked, bare, or detached
  worktrees are always preserved, even with --force. Without --force, unmerged
  branches and worktrees are preserved. Merged means merged into your
  current HEAD, so run from your default branch.

Examples:
  git fetch --prune
  git-rm-gone
  git-rm-gone --apply
  git-rm-gone --apply --force --yes
EOF
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --apply)
                APPLY=true
                ;;
            --yes | -y)
                ASSUME_YES=true
                ;;
            --force | -f)
                FORCE=true
                ;;
            --dry-run | -n)
                DRY_RUN=true
                ;;
            -h | --help)
                print_help
                exit 0
                ;;
            *)
                echo "git-rm-gone: unknown option: $1" >&2
                echo "Run 'git-rm-gone --help' for usage." >&2
                exit 2
                ;;
        esac
        shift
    done

    if [ "$ASSUME_YES" = true ] && [ "$APPLY" != true ]; then
        echo "git-rm-gone: --yes requires --apply" >&2
        exit 2
    fi
    if [ "$FORCE" = true ] && [ "$APPLY" != true ]; then
        echo "git-rm-gone: --force requires --apply" >&2
        exit 2
    fi
    if [ "$DRY_RUN" = true ] && [ "$APPLY" = true ]; then
        echo "git-rm-gone: --dry-run cannot be combined with --apply" >&2
        exit 2
    fi
}

# Branches checked out in any worktree (refs/heads/<name> per worktree).
worktree_branches() {
    git worktree list --porcelain 2>/dev/null | awk '/^branch / {print $2}' | sed 's|^refs/heads/||' || true
}

is_merged_into_head() {
    git merge-base --is-ancestor "$1" HEAD 2>/dev/null
}

# Populate WT_PATHS/WT_BRANCHES/WT_KINDS/WT_LOCKED from porcelain output.
# Index 0 is the main worktree.
collect_worktrees() {
    local line path="" branch="" kind="branch" locked=false

    WT_PATHS=()
    WT_BRANCHES=()
    WT_KINDS=()
    WT_LOCKED=()

    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            "worktree "*)
                if [[ -n "$path" ]]; then
                    WT_PATHS+=("$path")
                    WT_BRANCHES+=("$branch")
                    WT_KINDS+=("$kind")
                    WT_LOCKED+=("$locked")
                fi
                path="${line#worktree }"
                branch=""
                kind="branch"
                locked=false
                ;;
            "branch "*)
                branch="${line#branch refs/heads/}"
                ;;
            detached)
                kind="detached"
                ;;
            bare)
                kind="bare"
                ;;
            locked*)
                locked=true
                ;;
        esac
    done < <(git worktree list --porcelain)
    if [[ -n "$path" ]]; then
        WT_PATHS+=("$path")
        WT_BRANCHES+=("$branch")
        WT_KINDS+=("$kind")
        WT_LOCKED+=("$locked")
    fi
}

is_gone_branch() {
    local candidate
    for candidate in ${GONE[@]+"${GONE[@]}"}; do
        [[ "$candidate" == "$1" ]] && return 0
    done
    return 1
}

is_current_worktree() {
    [[ -n "$CURRENT_TOPLEVEL" ]] && [[ -e "$1" ]] && [[ "$CURRENT_TOPLEVEL" -ef "$1" ]]
}

# --ignored: plain `git worktree remove` deletes ignored files without
# complaint, so ignored content counts as uncommitted work here.
is_worktree_dirty() {
    [[ -n "$(git -C "$1" status --porcelain --ignored 2>/dev/null)" ]]
}

# True when $1 is checked out in a worktree slated for removal.
is_wt_removal_planned() {
    local candidate
    for candidate in ${WT_REMOVABLE_BRANCHES[@]+"${WT_REMOVABLE_BRANCHES[@]}"}; do
        [[ "$candidate" == "$1" ]] && return 0
    done
    return 1
}

# Path of the linked worktree checking out $1 (empty when none).
wt_path_for_branch() {
    local i
    for ((i = 1; i < ${#WT_PATHS[@]}; i++)); do
        if [[ "${WT_BRANCHES[$i]}" == "$1" ]]; then
            printf '%s\n' "${WT_PATHS[$i]}"
            return 0
        fi
    done
    return 1
}

# Fill WT_REMOVABLE, WT_REMOVABLE_BRANCHES, STALE_PATHS, and WT_REPORT.
classify_worktrees() {
    local i path branch

    WT_REMOVABLE=()
    WT_REMOVABLE_BRANCHES=()
    STALE_PATHS=()
    WT_REPORT=()

    for ((i = 1; i < ${#WT_PATHS[@]}; i++)); do
        path="${WT_PATHS[$i]}"
        branch="${WT_BRANCHES[$i]}"
        if [[ ! -e "$path" ]]; then
            STALE_PATHS+=("$path")
            WT_REPORT+=("$path (stale entry - will prune)")
        elif [[ "${WT_KINDS[$i]}" == "bare" ]]; then
            WT_REPORT+=("$path (bare worktree - will skip)")
        elif [[ "${WT_KINDS[$i]}" == "detached" ]]; then
            WT_REPORT+=("$path (detached HEAD - will skip)")
        elif [[ "${WT_LOCKED[$i]}" == true ]]; then
            WT_REPORT+=("$path [$branch] (locked - will skip)")
        elif is_current_worktree "$path"; then
            WT_REPORT+=("$path [$branch] (current worktree - will skip)")
        elif is_worktree_dirty "$path"; then
            WT_REPORT+=("$path [$branch] (uncommitted changes - will preserve)")
        elif ! is_gone_branch "$branch"; then
            WT_REPORT+=("$path [$branch] (upstream present - will skip)")
        elif is_merged_into_head "$branch"; then
            WT_REPORT+=("$path [$branch] (merged, upstream gone - will remove)")
            WT_REMOVABLE+=("$path")
            WT_REMOVABLE_BRANCHES+=("$branch")
        elif [ "$FORCE" = true ] && [ "$APPLY" = true ]; then
            WT_REPORT+=("$path [$branch] (UNMERGED, upstream gone - will force-remove)")
            WT_REMOVABLE+=("$path")
            WT_REMOVABLE_BRANCHES+=("$branch")
        else
            WT_REPORT+=("$path [$branch] (UNMERGED, upstream gone - will preserve; re-run with --apply --force to remove)")
        fi
    done
}

confirm_apply() {
    local branches="$1"
    local worktrees="$2"
    local answer

    if [ "$ASSUME_YES" = true ]; then
        return 0
    fi
    if [ ! -t 0 ]; then
        echo "git-rm-gone: refusing non-interactive deletion without --yes" >&2
        return 1
    fi

    echo ""
    printf "Delete %s branch(es) and remove %s worktree(s) as classified above? [y/N] " "$branches" "$worktrees"
    read -r -n 1 answer
    echo ""
    [[ "$answer" == [yY] ]]
}

main() {
    local current_branch branch wt_path
    local -a deletable=()
    local deleted=0 skipped=0 failed=0 wt_removed=0

    parse_args "$@"

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        echo "git-rm-gone: not inside a git repository" >&2
        exit 1
    fi

    # awk (not grep) so an empty result still exits 0 under `set -o pipefail`.
    mapfile -t GONE < <(git branch -vv | awk '/: gone]/ { sub(/^[*+ ]+/, ""); print $1 }')
    collect_worktrees
    CURRENT_TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || true)"

    if [ "${#GONE[@]}" -eq 0 ] && [ "${#WT_PATHS[@]}" -le 1 ]; then
        echo "No branches with gone upstreams found."
        exit 0
    fi

    current_branch="$(git branch --show-current || true)"
    classify_worktrees

    if [ "${#WT_PATHS[@]}" -gt 1 ]; then
        echo "Worktrees:"
        printf '  %s\n' "${WT_REPORT[@]}"
        echo ""
    fi

    echo "Branches with gone upstreams:"
    if [ "${#GONE[@]}" -eq 0 ]; then
        echo "  (none)"
    fi
    for branch in ${GONE[@]+"${GONE[@]}"}; do
        if [[ "$branch" == "$current_branch" ]]; then
            echo "  $branch (current branch - will skip)"
        elif is_wt_removal_planned "$branch"; then
            wt_path="$(wt_path_for_branch "$branch" || true)"
            if is_merged_into_head "$branch"; then
                echo "  $branch (merged - will remove worktree $wt_path, then delete with -d)"
            else
                echo "  $branch (UNMERGED - will remove worktree $wt_path, then force-delete with -D)"
            fi
            deletable+=("$branch")
        elif worktree_branches | grep -qxF "$branch"; then
            echo "  $branch (checked out in another worktree - will skip)"
        elif is_merged_into_head "$branch"; then
            echo "  $branch (merged - will delete with -d)"
            deletable+=("$branch")
        elif [ "$FORCE" = true ] && [ "$APPLY" = true ]; then
            echo "  $branch (UNMERGED - will force-delete with -D)"
            deletable+=("$branch")
        else
            echo "  $branch (UNMERGED - will preserve; re-run with --apply --force to delete)"
        fi
    done

    if [ "$APPLY" != true ]; then
        echo ""
        echo "Preview only. Re-run with --apply to remove dead worktrees and delete merged branches."
        echo "Unmerged branches and worktrees are preserved unless --force is also given."
        exit 0
    fi

    if ! confirm_apply "${#deletable[@]}" "${#WT_REMOVABLE[@]}"; then
        echo "git-rm-gone: cancelled" >&2
        exit 1
    fi

    echo ""
    for wt_path in ${WT_REMOVABLE[@]+"${WT_REMOVABLE[@]}"}; do
        echo "Removing worktree $wt_path..."
        # Plain `remove` (never --force): dirty worktrees are excluded above,
        # so this cannot discard uncommitted changes.
        if git worktree remove "$wt_path"; then
            ((wt_removed++)) || true
        else
            echo "Failed to remove worktree $wt_path; leaving it in place." >&2
            ((failed++)) || true
        fi
    done
    if [ "${#STALE_PATHS[@]}" -gt 0 ]; then
        echo "Pruning ${#STALE_PATHS[@]} stale worktree entr(ies)..."
        if git worktree prune; then
            : # entries reported in the preview above
        else
            echo "Failed to prune stale worktree entries." >&2
            ((failed++)) || true
        fi
    fi

    for branch in ${GONE[@]+"${GONE[@]}"}; do
        if [[ "$branch" == "$current_branch" ]]; then
            echo "Skipping $branch (current branch)"
            ((skipped++)) || true
            continue
        fi
        if worktree_branches | grep -qxF "$branch"; then
            echo "Skipping $branch (checked out in another worktree)"
            ((skipped++)) || true
            continue
        fi
        if is_merged_into_head "$branch"; then
            echo "Deleting $branch (merged)..."
            if git branch -d "$branch"; then
                ((deleted++)) || true
            else
                echo "Failed to delete $branch; leaving it in place." >&2
                ((failed++)) || true
            fi
        elif [ "$FORCE" = true ]; then
            echo "Force-deleting $branch (UNMERGED)..."
            if git branch -D "$branch"; then
                ((deleted++)) || true
            else
                echo "Failed to delete $branch; leaving it in place." >&2
                ((failed++)) || true
            fi
        else
            echo "Preserving $branch (unmerged work; re-run with --apply --force to delete)"
            ((skipped++)) || true
        fi
    done

    echo ""
    echo "Done: $deleted branches deleted, $wt_removed worktrees removed, $skipped skipped, $failed failed."
    if [ "$failed" -gt 0 ]; then
        exit 1
    fi
}

main "$@"
