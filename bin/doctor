#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=bin/lib/helpers.sh
source "$SCRIPT_DIR/lib/helpers.sh"
# shellcheck source=bin/lib/symlinks.sh
source "$SCRIPT_DIR/lib/symlinks.sh"
# shellcheck source=bin/lib/package-policy.sh
source "$SCRIPT_DIR/lib/package-policy.sh"

STRICT=false
CHECK_TOOLS=true
FAILURES=0
WARNINGS=0

print_help() {
    cat <<'EOF'
Usage: doctor [options]

Verify that dotfiles are installed correctly for the current HOME directory.

Options:
  --strict      Treat warnings as failures for command availability checks
  --skip-tools  Skip checking whether external commands are installed
  -h, --help    Show this help message
EOF
}

record_failure() {
    print_error "$1"
    FAILURES=$((FAILURES + 1))
}

record_warning() {
    print_info "warning: $1"
    WARNINGS=$((WARNINGS + 1))
}

# Canonical absolute path (accepts relative symlink targets).
resolve_path() {
    python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1" 2>/dev/null
}

check_symlink() {
    local label="$1"
    local target="$2"
    local expected="$3"
    local resolved_target resolved_expected raw

    if [ ! -L "$target" ]; then
        record_failure "$label is not a symlink: $target"
        return
    fi

    raw="$(readlink "$target")"
    resolved_target="$(resolve_path "$target")"
    resolved_expected="$(resolve_path "$expected")"

    if [ -z "$resolved_target" ] || [ -z "$resolved_expected" ]; then
        record_failure "$label could not resolve path (link=$raw expected=$expected)"
        return
    fi

    if [ "$resolved_target" != "$resolved_expected" ]; then
        record_failure "$label resolves to $resolved_target instead of $resolved_expected (link=$raw)"
        return
    fi

    print_success "$label -> $resolved_expected"
}

check_path_exists() {
    local label="$1"
    local target="$2"

    if [ ! -e "$target" ]; then
        record_failure "$label is missing: $target"
        return
    fi

    print_success "$label exists: $target"
}

check_command() {
    local command_name="$1"

    if command -v "$command_name" >/dev/null 2>&1; then
        print_success "Command available: $command_name"
        return
    fi

    if [ "$STRICT" = true ]; then
        record_failure "Missing command: $command_name"
    else
        record_warning "Missing command: $command_name"
    fi
}

check_mise_runtime() {
    local runtime="$1"
    local resolved

    if ! command -v mise >/dev/null 2>&1; then
        record_warning "$runtime should be managed by mise, but mise is not installed"
        return
    fi

    resolved="$(mise which "$runtime" 2>/dev/null || true)"
    if [ -n "$resolved" ]; then
        print_success "Mise manages $runtime: $resolved"
        return
    fi

    if command -v "$runtime" >/dev/null 2>&1; then
        record_warning "$runtime is available outside Mise; prefer: mise use -g $runtime"
    else
        record_warning "$runtime is missing; install it with: mise use -g $runtime"
    fi
}

check_global_package_paths() {
    local npm_prefix pnpm_global_bin

    if command -v npm >/dev/null 2>&1; then
        npm_prefix="$(npm prefix --global 2>/dev/null || true)"
        if [ "$npm_prefix" != "$HOME/.npm-global" ]; then
            record_warning "npm global prefix is ${npm_prefix:-unknown}; expected $HOME/.npm-global"
        elif [ ! -d "$npm_prefix" ]; then
            record_warning "npm global prefix is missing: $npm_prefix (re-run install.sh)"
        elif [[ ":$PATH:" != *":$npm_prefix/bin:"* ]]; then
            record_warning "npm global bin is not on PATH: $npm_prefix/bin"
        else
            print_success "npm global prefix is portable and on PATH"
        fi
    fi

    if command -v pnpm >/dev/null 2>&1; then
        pnpm_global_bin="$(pnpm bin --global 2>/dev/null || true)"
        if [ -z "$pnpm_global_bin" ]; then
            record_warning "pnpm global bin is not configured (run: pnpm setup)"
        elif [[ ":$PATH:" != *":$pnpm_global_bin:"* ]]; then
            record_warning "pnpm global bin is not on PATH: $pnpm_global_bin (run: pnpm setup)"
        else
            print_success "pnpm global bin is on PATH: $pnpm_global_bin"
        fi
    fi
}

check_preferred_cli_installers() {
    local id brew_kind brew_name command owner install_hint

    while IFS='|' read -r id brew_kind brew_name command owner install_hint; do
        case "$id" in
            '' | \#*) continue ;;
        esac
        [ "$owner" = "vendor" ] || continue
        command -v brew >/dev/null 2>&1 || continue

        if brew list --"$brew_kind" "$brew_name" >/dev/null 2>&1; then
            record_warning "$id is installed with Homebrew; $install_hint"
        elif command -v "$command" >/dev/null 2>&1; then
            print_success "$id is available without Homebrew: $(command -v "$command")"
        fi
    done < <(package_policy_records)
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --strict)
                STRICT=true
                shift
                ;;
            --skip-tools)
                CHECK_TOOLS=false
                shift
                ;;
            -h | --help)
                print_help
                exit 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                print_help
                exit 1
                ;;
        esac
    done
}

print_header() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Dotfiles Doctor${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

run_installed_state_checks() {
    print_section "Checking installed symlinks"
    echo ""

    while IFS='|' read -r source_rel target_rel _install_name doctor_label _description; do
        check_symlink "$doctor_label" "$HOME/$target_rel" "$DOTFILES_DIR/$source_rel"
    done < <(managed_symlinks_for_group config)

    while IFS='|' read -r source_rel target_rel _install_name doctor_label _description; do
        check_symlink "$doctor_label" "$HOME/$target_rel" "$DOTFILES_DIR/$source_rel"
    done < <(managed_symlinks_for_group home)
    echo ""
}

run_dependency_checks() {
    print_section "Checking bootstrap dependencies"
    echo ""

    check_path_exists "zsh modules directory" "$DOTFILES_DIR/zsh"
    check_path_exists "zsh theme" "$DOTFILES_DIR/chetmancini.zsh-theme"
    for module in \
        options path platform theme aliases git functions secrets \
        plugins fun \
        tools/fzf tools/zoxide tools/mise tools/direnv tools/atuin tools/completions; do
        check_path_exists "zsh module $module" "$DOTFILES_DIR/zsh/${module}.zsh"
    done
    if [ -e "$HOME/.tmux/plugins/tpm" ]; then
        print_success "TPM exists: $HOME/.tmux/plugins/tpm"
    else
        record_warning "TPM is missing (optional; install via install.sh tmux step)"
    fi

    # Secrets: prefer 1Password-backed file. Never read or print file contents.
    local has_plaintext=false
    local has_1p=false
    [ -f "$DOTFILES_DIR/api_keys.sh" ] && has_plaintext=true
    [ -f "$DOTFILES_DIR/api_keys_1password.sh" ] && has_1p=true

    if [ "$has_1p" = true ]; then
        print_success "1Password secrets file present (api_keys_1password.sh)"
        if command -v op >/dev/null 2>&1; then
            print_success "Command available: op"
            if op whoami >/dev/null 2>&1; then
                print_success "1Password CLI session active (op whoami)"
            else
                record_warning "op is installed but not signed in (unlock 1Password / op signin)"
            fi
        else
            record_warning "api_keys_1password.sh present but op (1Password CLI) is missing"
        fi
    fi

    if [ "$has_plaintext" = true ]; then
        if [ "$has_1p" = true ]; then
            print_info "api_keys.sh also present; 1Password file loads second and can override"
        else
            record_warning "Only plaintext api_keys.sh present — prefer api_keys_1password.sh"
        fi
    fi

    if [ "$has_plaintext" = false ] && [ "$has_1p" = false ]; then
        record_warning "No api_keys.sh or api_keys_1password.sh present"
    fi

    echo ""
}

run_repo_checks() {
    print_section "Checking repo health"
    echo ""

    if command -v zsh >/dev/null 2>&1; then
        if zsh -n "$DOTFILES_DIR/.zshrc"; then
            print_success ".zshrc parses with zsh"
        else
            record_failure ".zshrc failed zsh syntax check"
        fi
    else
        record_warning "Skipping zsh syntax check because zsh is unavailable"
    fi

    if bash -n "$DOTFILES_DIR/install.sh"; then
        print_success "install.sh parses with bash"
    else
        record_failure "install.sh failed bash syntax check"
    fi

    # MCP example: valid JSON and no placeholder live paths
    if [ -f "$DOTFILES_DIR/mcp.json.example" ]; then
        if python3 -m json.tool "$DOTFILES_DIR/mcp.json.example" >/dev/null 2>&1; then
            print_success "mcp.json.example is valid JSON"
        else
            record_warning "mcp.json.example is not valid JSON"
        fi
        if grep -q "/Users/username" "$DOTFILES_DIR/mcp.json.example" 2>/dev/null; then
            record_warning "mcp.json.example still contains placeholder /Users/username"
        fi
    else
        record_warning "mcp.json.example not found (see docs/agents.md)"
    fi
    # Live mcp.json is gitignored; warn only if it would be committed
    if [ -f "$DOTFILES_DIR/mcp.json" ] && ! grep -q "^mcp\.json" "$DOTFILES_DIR/.gitignore" 2>/dev/null; then
        record_warning "mcp.json exists but is not gitignored"
    fi

    # Claude agent layout: soft checks
    if [ -d "$DOTFILES_DIR/claude" ]; then
        [ -d "$DOTFILES_DIR/claude/agents" ] && print_success "claude/agents exists" || record_warning "claude/agents missing"
        [ -d "$DOTFILES_DIR/claude/commands" ] && print_success "claude/commands exists" || record_warning "claude/commands missing"
        # Guard against committed secrets in tracked agent files
        if grep -R -q "sk-[A-Za-z0-9]\{20,\}\|api_key\s*=" "$DOTFILES_DIR/claude" 2>/dev/null; then
            record_warning "claude/ contains possible secret literals (sk- / api_key=)"
        fi
        if grep -R -q "sk-[A-Za-z0-9]\{20,\}\|api_key\s*=" "$DOTFILES_DIR/mcp.json.example" 2>/dev/null; then
            record_warning "mcp.json.example contains possible secret literals"
        fi
    else
        record_warning "claude/ directory not found"
    fi

    echo ""
}

run_tool_checks() {
    if [ "$CHECK_TOOLS" != true ]; then
        print_section "Skipping command checks"
        echo ""
        print_info "Use doctor without --skip-tools to validate required commands"
        echo ""
        return
    fi

    print_section "Checking key commands"
    echo ""

    check_command git
    check_command zsh
    check_command tmux
    check_command nvim
    check_command eza
    check_command bat
    check_command fd
    check_command rg
    check_command fzf
    check_command yazi
    check_command zoxide
    check_command mise
    check_command atuin
    check_command direnv
    echo ""

    print_section "Checking package-manager policy"
    echo ""
    check_mise_runtime node
    check_mise_runtime python
    check_global_package_paths
    check_preferred_cli_installers
    echo ""
}

print_summary() {
    print_section "Summary"
    echo ""

    if [ "$WARNINGS" -gt 0 ]; then
        print_info "Warnings: $WARNINGS"
    fi

    if [ "$FAILURES" -gt 0 ]; then
        print_error "Failures: $FAILURES"
        exit 1
    fi

    print_success "Dotfiles look healthy"
}

parse_args "$@"
print_header
print_info "Dotfiles directory: $DOTFILES_DIR"
print_info "Home directory: $HOME"
echo ""

run_installed_state_checks
run_dependency_checks
run_repo_checks
run_tool_checks
print_summary
