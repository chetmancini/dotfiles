#!/usr/bin/env bash
# shellcheck shell=bash
set -euo pipefail

# brew-sync: Check and sync Brewfile with installed packages
#
# Usage:
#   brew-sync              # Check for drift and suggest actions
#   brew-sync --add        # Add missing packages to Brewfile
#   brew-sync --remove     # Remove uninstalled packages from Brewfile
#   brew-sync --update     # Update Brewfile from current packages
#   brew-sync --help       # Show help

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/lib/helpers.sh"
# shellcheck source=bin/lib/package-policy.sh
source "${PACKAGE_POLICY:-$SCRIPT_DIR/lib/package-policy.sh}"

BREWFILE="${BREWFILE:-$DOTFILES_DIR/Brewfile}"
BREWFILE_OPTIONAL="${BREWFILE_OPTIONAL:-$DOTFILES_DIR/Brewfile.optional}"
DRY_RUN=false

# Colors (redefine for standalone use)
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

print_header() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Brewfile Sync${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

print_help() {
    echo "Usage: brew-sync [options]"
    echo ""
    echo "Check and synchronize the core Brewfile with installed Homebrew packages."
    echo "Optional packages live in Brewfile.optional and are not required for a"
    echo "healthy core install. They are excluded from 'extra install' drift and"
    echo "are never removed by --remove from the optional file."
    echo "Tools listed in the package policy are also healthy when their preferred"
    echo "non-Homebrew installer supplies the executable."
    echo ""
    echo "Options:"
    echo "  --add          Add missing packages to core Brewfile"
    echo "  --remove       Remove uninstalled packages from core Brewfile"
    echo "  --update       Full update: brew bundle dump --force (core only)"
    echo "  --check        Only check for drift (default)"
    echo "  --dry-run      Show what would be done without making changes"
    echo "  -h, --help     Show this help message"
    echo ""
    echo "Environment:"
    echo "  BREWFILE=/path/to/Brewfile             Override core Brewfile path"
    echo "  BREWFILE_OPTIONAL=/path/to/Brewfile.optional  Optional profile path"
    echo ""
    echo "Examples:"
    echo "  brew-sync              # Check core Brewfile drift"
    echo "  brew-sync --add        # Add missing packages to core"
    echo "  brew-sync --update     # Regenerate core Brewfile from installed"
    echo "  brew bundle --file=~/dotfiles/Brewfile.optional  # install optional"
    exit 0
}

# Parse arguments
ACTION="check"
while [ $# -gt 0 ]; do
    case "$1" in
        --add)
            ACTION="add"
            shift
            ;;
        --remove)
            ACTION="remove"
            shift
            ;;
        --update)
            ACTION="update"
            shift
            ;;
        --check)
            ACTION="check"
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h | --help)
            print_help
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run 'brew-sync --help' for usage."
            exit 1
            ;;
    esac
done

# Check if Brewfile exists
if [ ! -f "$BREWFILE" ]; then
    echo -e "${RED}Error: Brewfile not found at $BREWFILE${NC}"
    exit 1
fi

print_header

# Normalize brewfile formula names to short form for brew list comparison
short_formula_names() {
    sed -E 's|.*/||'
}

# Shared helper to extract package names for a given type from a Brewfile.
# Handles both " and ' quotes, trailing args/comments, and for brew strips tap prefix.
_extract_brewfile_names() {
    local file="$1"
    local kind="$2" # brew or cask
    { grep -E '^[[:space:]]*'"${kind}"'[[:space:]]+["'\'']' "$file" 2>/dev/null || true; } |
        sed -E "s/^[[:space:]]*${kind}[[:space:]]+[\"']([^\"']+)[\"'].*/\1/" |
        { if [ "$kind" = "brew" ]; then short_formula_names; else cat; fi; } |
        sort -u
}

get_brewfile_formulae() { _extract_brewfile_names "$BREWFILE" brew; }
get_brewfile_casks() { _extract_brewfile_names "$BREWFILE" cask; }
get_optional_formulae() {
    [ -f "$BREWFILE_OPTIONAL" ] || return 0
    _extract_brewfile_names "$BREWFILE_OPTIONAL" brew
}
get_optional_casks() {
    [ -f "$BREWFILE_OPTIONAL" ] || return 0
    _extract_brewfile_names "$BREWFILE_OPTIONAL" cask
}

get_installed_formulae() { brew list --formula 2>/dev/null | sort -u; }
get_installed_casks() { brew list --cask 2>/dev/null | sort -u; }

# Remove package names represented by policy-satisfaction records. Arguments:
# newline-delimited package names, newline-delimited package|owner|command|hint.
exclude_policy_satisfied_packages() {
    local packages="$1"
    local satisfactions="$2"
    local package

    [ -n "$packages" ] || return 0
    while IFS= read -r package; do
        [ -n "$package" ] || continue
        if ! printf '%s\n' "$satisfactions" | cut -d'|' -f1 | grep -Fxq "$package"; then
            printf '%s\n' "$package"
        fi
    done <<EOF
$packages
EOF

    return 0
}

print_policy_satisfaction() {
    local satisfactions="$1"
    local package owner command install_hint

    [ -n "$satisfactions" ] || return 0
    echo -e "${BLUE}Tools supplied outside Homebrew by policy:${NC}"
    while IFS='|' read -r package owner command install_hint; do
        [ -n "$package" ] || continue
        echo "  • $package: $owner via $command ($install_hint)"
    done <<EOF
$satisfactions
EOF
    echo ""
}

# Compare and report drift
check_drift() {
    echo -e "${BLUE}Checking for drift...${NC}"
    echo ""

    local brewfile_formulae installed_formulae
    local brewfile_casks installed_casks

    brewfile_formulae=$(get_brewfile_formulae)
    installed_formulae=$(get_installed_formulae)
    brewfile_casks=$(get_brewfile_casks)
    installed_casks=$(get_installed_casks)
    local optional_formulae optional_casks
    optional_formulae=$(get_optional_formulae)
    optional_casks=$(get_optional_casks)

    # Formulae in Brewfile but not installed
    local formulae_not_installed
    formulae_not_installed=$(comm -23 <(echo "$brewfile_formulae") <(echo "$installed_formulae"))
    local external_formulae
    external_formulae=$(package_policy_external_satisfaction brew "$formulae_not_installed")
    formulae_not_installed=$(exclude_policy_satisfied_packages "$formulae_not_installed" "$external_formulae")

    # Formulae installed but not in core Brewfile (ignore optional profile)
    local formulae_not_in_brewfile
    formulae_not_in_brewfile=$(comm -13 <(echo "$brewfile_formulae") <(echo "$installed_formulae"))
    if [ -n "$optional_formulae" ]; then
        formulae_not_in_brewfile=$(comm -23 <(echo "$formulae_not_in_brewfile") <(echo "$optional_formulae"))
    fi

    # Casks in Brewfile but not installed
    local casks_not_installed
    casks_not_installed=$(comm -23 <(echo "$brewfile_casks") <(echo "$installed_casks"))
    local external_casks
    external_casks=$(package_policy_external_satisfaction cask "$casks_not_installed")
    casks_not_installed=$(exclude_policy_satisfied_packages "$casks_not_installed" "$external_casks")

    # Casks installed but not in core Brewfile (ignore optional profile)
    local casks_not_in_brewfile
    casks_not_in_brewfile=$(comm -13 <(echo "$brewfile_casks") <(echo "$installed_casks"))
    if [ -n "$optional_casks" ]; then
        casks_not_in_brewfile=$(comm -23 <(echo "$casks_not_in_brewfile") <(echo "$optional_casks"))
    fi

    # Print results
    local issues_found=false

    print_policy_satisfaction "$external_formulae"
    print_policy_satisfaction "$external_casks"

    if [ -n "$formulae_not_installed" ]; then
        echo -e "${YELLOW}Formulae in Brewfile but not installed:${NC}"
        echo "$formulae_not_installed" | while read -r pkg; do
            echo "  • $pkg"
        done
        echo ""
        issues_found=true
    fi

    if [ -n "$casks_not_installed" ]; then
        echo -e "${YELLOW}Casks in Brewfile but not installed:${NC}"
        echo "$casks_not_installed" | while read -r pkg; do
            echo "  • $pkg"
        done
        echo ""
        issues_found=true
    fi

    if [ -n "$formulae_not_in_brewfile" ]; then
        echo -e "${YELLOW}Formulae installed but not in Brewfile:${NC}"
        # Resolve autoremovable deps once instead of once per package
        local autoremovable
        autoremovable=$(brew autoremove --dry-run 2>/dev/null || true)
        echo "$formulae_not_in_brewfile" | while read -r pkg; do
            # Skip autoremovable packages
            if ! echo "$autoremovable" | grep -qx "$pkg"; then
                echo "  • $pkg"
            fi
        done
        echo ""
        issues_found=true
    fi

    if [ -n "$casks_not_in_brewfile" ]; then
        echo -e "${YELLOW}Casks installed but not in Brewfile:${NC}"
        echo "$casks_not_in_brewfile" | while read -r pkg; do
            echo "  • $pkg"
        done
        echo ""
        issues_found=true
    fi

    # Check for outdated packages
    echo -e "${BLUE}Checking for outdated packages...${NC}"
    local outdated
    outdated=$(brew outdated 2>/dev/null || true)
    if [ -n "$outdated" ]; then
        local outdated_count
        outdated_count=$(echo "$outdated" | wc -l | tr -d ' ')
        echo -e "${YELLOW}$outdated_count outdated package(s) found${NC}"
        echo "$outdated" | head -10 | while read -r pkg; do
            echo "  • $pkg"
        done
        if [ "$outdated_count" -gt 10 ]; then
            echo "  ... and $((outdated_count - 10)) more"
        fi
        echo ""
        issues_found=true
    else
        echo -e "${GREEN}✓ All packages are up to date${NC}"
        echo ""
    fi

    if [ -f "$BREWFILE_OPTIONAL" ]; then
        echo -e "${BLUE}Note: optional packages in $(basename "$BREWFILE_OPTIONAL") are ignored for core drift.${NC}"
        echo ""
    fi

    if [ "$issues_found" = false ]; then
        echo -e "${GREEN}✓ Core Brewfile is in sync with installed packages${NC}"
        return 0
    else
        echo -e "${BLUE}Run 'brew-sync --add' to add missing packages to core Brewfile${NC}"
        echo -e "${BLUE}Run 'brew-sync --remove' to clean up core Brewfile${NC}"
        echo -e "${BLUE}Run 'brew-sync --update' to regenerate core Brewfile from installed${NC}"
        echo -e "${BLUE}Optional apps: brew bundle --file=$BREWFILE_OPTIONAL${NC}"
        return 1
    fi
}

# Add missing packages to Brewfile
add_missing() {
    if [ "$DRY_RUN" = true ]; then
        echo -e "${BLUE}[DRY RUN] Would add missing packages to Brewfile${NC}"
    else
        echo -e "${BLUE}Adding missing packages to Brewfile...${NC}"
    fi

    local brewfile_formulae installed_formulae
    local brewfile_casks installed_casks

    brewfile_formulae=$(get_brewfile_formulae)
    installed_formulae=$(get_installed_formulae)
    brewfile_casks=$(get_brewfile_casks)
    installed_casks=$(get_installed_casks)
    local optional_formulae optional_casks
    optional_formulae=$(get_optional_formulae)
    optional_casks=$(get_optional_casks)

    # Find formulae installed but missing from core (do not pull optional into core)
    local formulae_to_add
    formulae_to_add=$(comm -13 <(echo "$brewfile_formulae") <(echo "$installed_formulae"))
    if [ -n "$optional_formulae" ]; then
        formulae_to_add=$(comm -23 <(echo "$formulae_to_add") <(echo "$optional_formulae"))
    fi

    # Find casks installed but missing from core (do not pull optional into core)
    local casks_to_add
    casks_to_add=$(comm -13 <(echo "$brewfile_casks") <(echo "$installed_casks"))
    if [ -n "$optional_casks" ]; then
        casks_to_add=$(comm -23 <(echo "$casks_to_add") <(echo "$optional_casks"))
    fi

    if [ -z "$formulae_to_add" ] && [ -z "$casks_to_add" ]; then
        echo -e "${GREEN}✓ Nothing to add to core Brewfile${NC}"
        return 0
    fi

    # Add formulae
    if [ -n "$formulae_to_add" ]; then
        echo -e "${BLUE}Adding formulae:${NC}"
        echo "$formulae_to_add" | while read -r pkg; do
            echo "  + $pkg"
            if [ "$DRY_RUN" = false ]; then
                # Try to detect if it has a tap
                local tap_info
                tap_info=$(brew info "$pkg" 2>/dev/null | head -1 || true)
                if echo "$tap_info" | grep -q "/"; then
                    # Has a tap prefix
                    echo "brew \"$pkg\"" >>"$BREWFILE"
                else
                    echo "brew \"$pkg\"" >>"$BREWFILE"
                fi
            fi
        done
    fi

    # Add casks
    if [ -n "$casks_to_add" ]; then
        echo ""
        echo -e "${BLUE}Adding casks:${NC}"
        echo "$casks_to_add" | while read -r pkg; do
            echo "  + $pkg"
            if [ "$DRY_RUN" = false ]; then
                echo "cask \"$pkg\"" >>"$BREWFILE"
            fi
        done
    fi

    if [ "$DRY_RUN" = false ]; then
        echo ""
        echo -e "${GREEN}✓ Packages added to Brewfile${NC}"
        echo -e "${YELLOW}Note: You may want to organize the Brewfile manually${NC}"
    fi
}

# Remove uninstalled packages from Brewfile
remove_uninstalled() {
    if [ "$DRY_RUN" = true ]; then
        echo -e "${BLUE}[DRY RUN] Would remove uninstalled packages from Brewfile${NC}"
    else
        echo -e "${BLUE}Removing uninstalled packages from Brewfile...${NC}"
    fi

    local brewfile_formulae installed_formulae
    local brewfile_casks installed_casks

    brewfile_formulae=$(get_brewfile_formulae)
    installed_formulae=$(get_installed_formulae)
    brewfile_casks=$(get_brewfile_casks)
    installed_casks=$(get_installed_casks)

    # Find formulae to remove
    local formulae_to_remove
    formulae_to_remove=$(comm -23 <(echo "$brewfile_formulae") <(echo "$installed_formulae"))
    local external_formulae
    external_formulae=$(package_policy_external_satisfaction brew "$formulae_to_remove")
    formulae_to_remove=$(exclude_policy_satisfied_packages "$formulae_to_remove" "$external_formulae")

    # Find casks to remove
    local casks_to_remove
    casks_to_remove=$(comm -23 <(echo "$brewfile_casks") <(echo "$installed_casks"))
    local external_casks
    external_casks=$(package_policy_external_satisfaction cask "$casks_to_remove")
    casks_to_remove=$(exclude_policy_satisfied_packages "$casks_to_remove" "$external_casks")

    print_policy_satisfaction "$external_formulae"
    print_policy_satisfaction "$external_casks"

    if [ -z "$formulae_to_remove" ] && [ -z "$casks_to_remove" ]; then
        echo -e "${GREEN}✓ Nothing to remove${NC}"
        return 0
    fi

    # Show what will be removed
    if [ -n "$formulae_to_remove" ]; then
        echo -e "${YELLOW}Formulae to remove:${NC}"
        echo "$formulae_to_remove" | while read -r pkg; do
            echo "  - $pkg"
        done
    fi

    if [ -n "$casks_to_remove" ]; then
        echo ""
        echo -e "${YELLOW}Casks to remove:${NC}"
        echo "$casks_to_remove" | while read -r pkg; do
            echo "  - $pkg"
        done
    fi

    if [ "$DRY_RUN" = false ]; then
        # Create backup
        cp "$BREWFILE" "$BREWFILE.backup.$(date +%Y%m%d-%H%M%S)"

        # Remove lines from Brewfile
        local temp_file
        temp_file=$(mktemp)

        while IFS= read -r line; do
            local should_keep=true

            # Check if line is a brew line with a package to remove
            if echo "$line" | grep -qE '^[[:space:]]*brew[[:space:]]+["'\'']'; then
                local pkg
                pkg=$(echo "$line" | sed -E "s/^[[:space:]]*brew[[:space:]]+[\"']([^\"']+)[\"'].*/\1/" | short_formula_names)
                if echo "$formulae_to_remove" | grep -Fxq "$pkg"; then
                    should_keep=false
                fi
            fi

            # Check if line is a cask line with a package to remove
            if echo "$line" | grep -qE '^[[:space:]]*cask[[:space:]]+["'\'']'; then
                local pkg
                pkg=$(echo "$line" | sed -E "s/^[[:space:]]*cask[[:space:]]+[\"']([^\"']+)[\"'].*/\1/")
                if echo "$casks_to_remove" | grep -Fxq "$pkg"; then
                    should_keep=false
                fi
            fi

            if [ "$should_keep" = true ]; then
                echo "$line" >>"$temp_file"
            fi
        done <"$BREWFILE"

        mv "$temp_file" "$BREWFILE"

        echo ""
        echo -e "${GREEN}✓ Uninstalled packages removed from Brewfile${NC}"
        echo -e "${BLUE}Backup saved to:${NC} $BREWFILE.backup.*"
    fi
}

# Drop entries from a generated Brewfile when the policy's preferred non-Brew
# owner already provides them. `brew bundle dump` cannot express this itself.
prune_policy_satisfied_entries() {
    local temp_file line kind package satisfaction

    temp_file=$(mktemp)
    while IFS= read -r line; do
        kind=""
        package=""
        if echo "$line" | grep -qE '^[[:space:]]*brew[[:space:]]+["'\'']'; then
            kind="brew"
            package=$(echo "$line" | sed -E "s/^[[:space:]]*brew[[:space:]]+[\"']([^\"']+)[\"'].*/\1/" | short_formula_names)
        elif echo "$line" | grep -qE '^[[:space:]]*cask[[:space:]]+["'\'']'; then
            kind="cask"
            package=$(echo "$line" | sed -E "s/^[[:space:]]*cask[[:space:]]+[\"']([^\"']+)[\"'].*/\1/")
        fi

        if [ -n "$kind" ]; then
            satisfaction=$(package_policy_external_satisfaction "$kind" "$package")
            if [ -n "$satisfaction" ]; then
                print_policy_satisfaction "$satisfaction"
                continue
            fi
        fi
        echo "$line" >>"$temp_file"
    done <"$BREWFILE"

    mv "$temp_file" "$BREWFILE"
}

# Full update - regenerate Brewfile
update_brewfile() {
    if [ "$DRY_RUN" = true ]; then
        echo -e "${BLUE}[DRY RUN] Would regenerate Brewfile from installed packages${NC}"
    else
        echo -e "${BLUE}Regenerating Brewfile...${NC}"
        echo -e "${YELLOW}This will overwrite your current Brewfile!${NC}"
        read -p "Continue? [y/N] " -n 1 -r
        echo ""
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Cancelled."
            exit 0
        fi

        # Backup existing
        cp "$BREWFILE" "$BREWFILE.backup.$(date +%Y%m%d-%H%M%S)"

        # Regenerate
        brew bundle dump --file="$BREWFILE" --force
        prune_policy_satisfied_entries

        echo ""
        echo -e "${GREEN}✓ Brewfile updated${NC}"
        echo -e "${BLUE}Backup saved to:${NC} $BREWFILE.backup.*"
        echo -e "${YELLOW}Note: You may want to reorganize categories manually${NC}"
    fi
}

# Main
case "$ACTION" in
    check)
        check_drift
        ;;
    add)
        add_missing
        ;;
    remove)
        remove_uninstalled
        ;;
    update)
        update_brewfile
        ;;
    *)
        echo "Unknown action: $ACTION"
        exit 1
        ;;
esac
